{
  "name": "ugeen-automation",
  "version": "1.0.0",
  "description": "IPTV Activation Code Automation System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:automation && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:automation": "cd automation && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start-automation": "cd backend && npm run start",
    "typecheck": "cd backend && npx tsc --noEmit && cd ../automation && npx tsc --noEmit && cd ../frontend && npx tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
